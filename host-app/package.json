{
  "name": "remote-desktop-host",
  "version": "1.0.3",
  "description": "Remote Desktop pilot — host app. Runs on the Windows machine being controlled: captures its screen + system audio, streams both over WebRTC to whoever connects with the pairing code, and injects the incoming remote mouse/keyboard events back into the real OS. Also runs the signaling server itself, so this one app is the only thing that needs to be launched.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "publish": "electron-builder --win nsis portable --publish always"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.3.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mimigames.remotedesktop",
    "productName": "Remote Desktop Host",
    "files": ["main.js", "preload.js", "renderer.js", "index.html", "signaling.js", "viewer/**/*"],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "asherwin86",
      "repo": "owen-remote-pc"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
